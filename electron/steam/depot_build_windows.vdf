// SteamPipe depot for Landed on windows (TEMPLATE). Referenced from app_build.vdf.
// Content: export/desktop/win-unpacked/ (built by `npm run desktop:build` on windows).
// Set this depot's OS to windows in Steamworks, and the launch option to: Landed.exe
"DepotBuild"
{
	"DepotID" "REPLACE_WITH_WINDOWS_DEPOT_ID"
	"FileMapping"
	{
		"LocalPath" "win-unpacked/*"
		"DepotPath" "."
		"Recursive" "1"
	}
	"FileExclusion" "steam_appid.txt" // local testing only, never shipped
	"FileExclusion" "*.pdb"
}
